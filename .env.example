# Public site URL used for canonical URLs, Open Graph, sitemap and robots. Required in production.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Optional: Google AdSense. Leave empty to show no ads.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT=

# Optional: Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave empty to disable analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
